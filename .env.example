# Scraper / ETL (optional local)
LOG_LEVEL=INFO
LOG_FILE=logs/scraper.log
MIN_DELAY=1.5
MAX_DELAY=5.5
DB_PATH=data/pse_analysis.db

# Django API (local defaults keep DEBUG on; leave secret unset)
# DJANGO_DEBUG=true
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
# CORS_ALLOWED_ORIGINS=

# Production (Render): set DJANGO_DEBUG=false and require the rest
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=generate-a-long-random-string
# DJANGO_ALLOWED_HOSTS=.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
